# Paths are local configuration, never hardcoded in application source.
# Separate GPU model runtimes from the web/MuJoCo environment.
R2S_SAM3_PYTHON=/absolute/path/to/sam3/environment/bin/python
R2S_SAM3_CHECKPOINT=/absolute/path/to/sam3.pt
# Optional; leave unset until official gated weights and dependencies are ready.
# R2S_SAM3D_PYTHON=/absolute/path/to/sam3d/environment/bin/python
# R2S_SAM3D_REPO=/absolute/path/to/sam-3d-objects
# R2S_SAM3D_CONFIG=/absolute/path/to/checkpoints/pipeline.yaml
